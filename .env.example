# Telegram
TELEGRAM_BOT_TOKEN=1234567890:YOUR_TELEGRAM_BOT_TOKEN
# Белый список пользователей: этим Telegram ID доступны команды и приходят автоматические отчёты
# Несколько Telegram ID указывайте через запятую
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# Wildberries cabinet 1
WB_TOKEN_1=YOUR_WB_STATISTICS_TOKEN_1
